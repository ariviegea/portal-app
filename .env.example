# Copy this file to .env.local and fill in real values.
# .env.local is ignored by git, so keys and secrets in it are never pushed.
# This example file IS committed: keep only placeholders here, never real values.

# API addresses (optional; these are the defaults)
NPM_API_URL=https://registry.npmjs.org
MAVEN_API_URL=https://search.maven.org
GITHUB_API_URL=https://api.github.com

# Sonatype Guide API token, used by `npm run audit:sonatype`.
# Free at https://guide.sonatype.com under Settings > API Tokens.
AUDITJS_GUIDE_TOKEN=

# Other keys and secrets go below, for example:
# MY_API_KEY=
#
# Only code that runs on the server can read these. Never start a secret's
# name with NEXT_PUBLIC_, because Next.js sends those values to the browser.
